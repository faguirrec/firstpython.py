# Copia este archivo como server/.env y completa los valores.

PORT=4000
# Origen del frontend. Úsalo si corres el front aparte con `npm run dev` (:5173).
# Si el servidor sirve la app compilada en su mismo puerto, pon http://localhost:4000.
# Después de conectar Gmail, la app vuelve al origen desde el que se abrió,
# siempre que coincida con este valor o con el puerto del propio servidor.
WEB_ORIGIN=http://localhost:5173
# Cadena larga y aleatoria. Genérala con:  openssl rand -hex 32
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Ruta del archivo SQLite.
DB_PATH=./data/hogar.db

# Quién puede crear una cuenta:
#   open   = cualquiera (cómodo en local)
#   invite = sólo con código; la primera cuenta se permite si la base está vacía
#   closed = nadie más (lo indicado una vez que ambos ya entraron)
ALLOW_SIGNUP=open

# Ponlo en 1 sólo si hay un proxy delante (Fly.io, Render, un túnel).
# En producción se activa solo.
# TRUST_PROXY=1

# --- Correo (opcional: invitaciones y resumen mensual) ---
# Sin SMTP_HOST el correo queda apagado y la app funciona igual.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com y como
# SMTP_PASS una "contraseña de aplicación" (requiere verificación en dos pasos),
# nunca la contraseña normal de la cuenta.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=tu API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cuentas del Hogar <tu@gmail.com>

# Dominio definitivo, si usas uno propio. Todo lo que llegue por otra dirección
# se redirige acá, para que exista una sola app instalable y una sola sesión.
# CANONICAL_HOST=www.midominio.cl

# Clave para que un cron externo pueda disparar el resumen mensual.
# Genérala con: openssl rand -hex 24
CRON_SECRET=

# --- Leer el correo del banco ---
#
# La forma recomendada es IMAP con una contraseña de aplicación, y no se
# configura acá: se conecta desde la app, en Ajustes → Correo. No hace falta
# ninguna variable.
#
# Estas dos ajustan el comportamiento, y por defecto están bien:
# CORREO_TIEMPO_REAL=0        apaga la conexión permanente y deja sólo el sondeo
# CORREO_SONDEO_MINUTOS=15    cada cuánto revisa el buzón por si acaso

# Las credenciales del buzón se guardan cifradas. La llave sale de JWT_SECRET;
# defínela aparte sólo si quieres poder rotar el secreto de sesión sin que las
# cuentas de correo haya que reconectarlas.
# ENCRYPTION_KEY=

# --- Gmail por OAuth (la otra forma; opcional) ---
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: si no se define, se deduce de la dirección pública de la app.
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
