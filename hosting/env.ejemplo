# Copia este archivo como `.env` en esta misma carpeta y complétalo.
#
#   cp env.ejemplo .env
#
# El `.env` no se sube al repositorio: son claves.

# ----------------------------- Imprescindible ----------------------------

# Firma las sesiones. Genera una así y pégala acá:
#   openssl rand -hex 32
# Si la cambias, todos quedan desconectados y tienen que entrar de nuevo.
JWT_SECRET=

# Dirección pública de la app. De acá salen el enlace de las invitaciones y la
# dirección de retorno de Google.
WEB_ORIGIN=https://app.myhaus.cl

# Todo lo que llegue por otra dirección se redirige a ésta, para que la app
# instalada en el teléfono sea una sola.
CANONICAL_HOST=app.myhaus.cl

# open = cualquiera puede registrarse · invite = sólo con código · closed = nadie
# Conviene dejarlo en `invite` mientras se arma el hogar, y en `closed` después.
ALLOW_SIGNUP=invite

# ------------------------- Correo del banco (Gmail) ----------------------
# Desde Google Cloud → APIs y servicios → Credenciales.
# La URI de retorno autorizada tiene que ser exactamente:
#   https://app.myhaus.cl/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------ Invitaciones y reporte mensual (SMTP) ----------------
# Sin SMTP_HOST el correo queda apagado y la app funciona igual, sólo que las
# invitaciones hay que pasarlas a mano por el enlace.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MyHaus <hola@myhaus.cl>

# ---------------------------- Tareas programadas -------------------------
# Clave para disparar el reporte mensual desde fuera. Genérala igual que la
# anterior. Si la dejas vacía, ese acceso queda cerrado.
CRON_SECRET=
