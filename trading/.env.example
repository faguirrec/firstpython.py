# ---------------------------------------------------------------------------
# Alpaca. Empieza SIEMPRE en paper: https://paper-api.alpaca.markets
# El balance de la cuenta paper se configura desde el dashboard de Alpaca ($30).
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Clasificación de sentimiento con Claude. Sin esta clave el sistema usa un
# clasificador léxico de respaldo (mucho menos preciso, confianza limitada).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fuente de noticias redundante (opcional): finnhub | newsapi
NEWS_PROVIDER=finnhub
NEWS_API_KEY=

# --------------------------- Datos de mercado ------------------------------
# De dónde salen las BARRAS. La ejecución siempre va por Alpaca.
#   alpaca       gratis, tiempo real, feed IEX (por defecto)
#   polygon      gratis: 5 req/min y 15 min de retraso; tiempo real desde ~$199/mes
#   alphavantage gratis: 25 peticiones POR DÍA y sin bid/ask
# Con un proveedor con retraso, las COTIZACIONES siguen viniendo de Alpaca:
# una orden limit nunca se fija con datos rezagados.
MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_API_KEY=
# true solo si pagas un plan en tiempo real del proveedor elegido.
MARKET_DATA_REALTIME=false
MARKET_DATA_RPM=5
# iex (gratis) o sip (requiere Algo Trader Plus, ~$99/mes)
ALPACA_FEED=iex

# Alertas (opcionales)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
SMTP_URL=

# --------------------------- Horario de mercado ----------------------------
# De qué bolsa se toman las horas de operación. Solo XNYS es operable vía Alpaca;
# los demás perfiles sirven para monitoreo correcto en otras regiones.
#   XNYS (EE.UU.) · XLON (Londres) · XETR (Frankfurt) · XTKS (Tokio) · XHKG (HK)
EXCHANGE=XNYS
# Calendario propio (JSON). Ver DEPLOY.md.
EXCHANGE_CALENDAR_FILE=
# Feriados extra, separados por coma: 2026-09-18,2026-09-19
EXCHANGE_EXTRA_HOLIDAYS=

# ------------------------------ Monitoreo ----------------------------------
# 0 desactiva el endpoint. En una plataforma cloud usa 8080 (o deja que PORT lo fije).
HEALTH_PORT=0
# Obligatorio para exponer /status: sin token, /status se niega a responder.
HEALTH_TOKEN=

# ------------------------------- Operación ---------------------------------
DATABASE_URL=data/trading_bot.db
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.jsonl
UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMD,TSLA,F
BENCHMARK=SPY
EXPERIMENT_DAYS=30
TRADE_INTERVAL_MINUTES=15
NEWS_INTERVAL_MINUTES=20
# DRY_RUN=true registra decisiones sin enviar órdenes al broker.
DRY_RUN=false

# ---------------------------------- Riesgo ---------------------------------
STARTING_EQUITY=30
MAX_POSITION_PCT=0.34
MIN_POSITION_NOTIONAL=1.00
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=6
MAX_DAILY_LOSS_PCT=0.06
MAX_DRAWDOWN_PCT=0.20
MIN_NET_EV_USD=0.005
MIN_NET_EV_BPS=10
MIN_CONFIDENCE=0.35
# Cuánto puede sumar una señal maximamente confiable a la probabilidad de acierto
# base. Es un supuesto, no una medición: calíbralo con `trading-bot calibrate`.
# 0.05 nunca opera; 0.25 empeora el resultado en las pruebas. 0.15 es el óptimo medido.
CONFIDENCE_EDGE_CAP=0.15
TAKE_PROFIT_PCT=0.03
STOP_LOSS_PCT=0.02
MAX_HOLDING_DAYS=5
CONSECUTIVE_ERROR_LIMIT=5

# ----------------------------- Modelo de costos ----------------------------
# Alpaca no cobra comisión en acciones de EE.UU.; los fees regulatorios sí
# aplican en las VENTAS y sus tasas cambian: verifícalas antes de operar live.
COMMISSION_PER_ORDER=0
COMMISSION_PER_SHARE=0
SEC_FEE_RATE=0.0000278
TAF_PER_SHARE=0.000166
TAF_MAX_PER_ORDER=8.30
DEFAULT_HALF_SPREAD_BPS=5
# Piso para el medio spread cotizado: un mercado cruzado o trabado no puede
# hacer que el viaje de ida y vuelta parezca gratis.
MIN_HALF_SPREAD_BPS=1
SLIPPAGE_BPS=2
