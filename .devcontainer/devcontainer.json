{
  "name": "MyHaus",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  // Deja el entorno listo: dependencias instaladas y flyctl disponible.
  // Así el Codespace sirve tanto para probar la app como para publicarla,
  // sin instalar nada en el computador propio.
  "postCreateCommand": "bash .devcontainer/preparar.sh",

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.fly/bin",
    "FLYCTL_INSTALL": "/home/node/.fly"
  },

  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "MyHaus",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
