# Copia como .env (o expórtalas en tu shell). Ninguna es obligatoria en desarrollo.

# Base de datos. Sin ella se usa SQLite en instance/pucon.db.
# DATABASE_URL=postgresql://usuario:clave@host:5432/pucon

# Obligatoria en producción (FLASK_ENV=production o Render). Cadena larga y aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Crean el primer administrador si la base no tiene usuarios.
# ADMIN_EMAIL=admin@pucon.cl
# ADMIN_PASSWORD=cambia-esto-ya
# ADMIN_NOMBRE=Administrador

# Carga clientes, equipos y arriendos de ejemplo en una base sin equipos.
# SEED_DEMO=1

# 1 si corre detrás de un proxy (Render, Nginx) para leer bien IP y https.
# TRUST_PROXY=1
